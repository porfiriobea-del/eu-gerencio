# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Server-side primary and fallback models for missing models, quota or temporary provider failures.
GEMINI_MODEL="gemini-3.5-flash"
GEMINI_FALLBACK_MODEL="gemini-3.1-flash-lite"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase public project settings (never use a service_role key in VITE_ variables).
VITE_SUPABASE_URL="https://zixwpheatwyptkqpzgdg.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InppeHdwaGVhdHd5cHRrcXB6Z2RnIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTA4MTkxNDUsImV4cCI6MjEwNjM5NTE0NX0.ioEXPQlmL-5bRyZuChmoxkg2veYNMi8lSD6_BehyuAU"
# Optional alias: VITE_SUPABASE_KEY takes precedence over VITE_SUPABASE_ANON_KEY.

# Server-only reporting. Set the real secret securely in Vercel, never in VITE_ variables.
APPS_SCRIPT_URL="https://script.google.com/macros/s/AKfycbxz_eklg-nmMFKsFhY0ipNnIQZIqLiqO69f90tXTFtzFsJhVwPf5CZJkA4nlW-YAHpk6A/exec"
